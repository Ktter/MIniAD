<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ego_vehicle_ackermann">
    <pose>0 0 0.34 0 0 0</pose>
    <link name="chassis">
      <inertial><mass>1200</mass><inertia><ixx>500</ixx><iyy>900</iyy><izz>1000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><box><size>2.4 1.4 0.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>2.4 1.4 0.5</size></box></geometry><material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
    </link>

    <link name="front_left_knuckle"><pose>0.8 0.82 0 0 0 0</pose><inertial><mass>15</mass><inertia><ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link>
    <link name="front_right_knuckle"><pose>0.8 -0.82 0 0 0 0</pose><inertial><mass>15</mass><inertia><ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link>

    <link name="front_left_wheel"><pose>0.8 0.82 0 0 0 0</pose><inertial><mass>20</mass><inertia><ixx>0.579</ixx><iyy>1.024</iyy><izz>0.579</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.3</mu2><slip1>0.01</slip1><slip2>0.02</slip2></ode></friction><contact><ode><kp>100000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact></surface></collision><visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry></visual></link>
    <link name="front_right_wheel"><pose>0.8 -0.82 0 0 0 0</pose><inertial><mass>20</mass><inertia><ixx>0.579</ixx><iyy>1.024</iyy><izz>0.579</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.3</mu2><slip1>0.01</slip1><slip2>0.02</slip2></ode></friction><contact><ode><kp>100000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact></surface></collision><visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry></visual></link>
    <link name="rear_left_wheel"><pose>-0.8 0.82 0 0 0 0</pose><inertial><mass>20</mass><inertia><ixx>0.579</ixx><iyy>1.024</iyy><izz>0.579</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.3</mu2><slip1>0.01</slip1><slip2>0.02</slip2></ode></friction><contact><ode><kp>100000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact></surface></collision><visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry></visual></link>
    <link name="rear_right_wheel"><pose>-0.8 -0.82 0 0 0 0</pose><inertial><mass>20</mass><inertia><ixx>0.579</ixx><iyy>1.024</iyy><izz>0.579</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.3</mu2><slip1>0.01</slip1><slip2>0.02</slip2></ode></friction><contact><ode><kp>100000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact></surface></collision><visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry></visual></link>

    <joint name="front_left_steering_joint" type="revolute"><pose>0 0 0 0 0 0</pose><parent>chassis</parent><child>front_left_knuckle</child><axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>300</effort><velocity>1.0</velocity></limit><dynamics><damping>5</damping><friction>0.5</friction></dynamics></axis></joint>
    <joint name="front_right_steering_joint" type="revolute"><pose>0 0 0 0 0 0</pose><parent>chassis</parent><child>front_right_knuckle</child><axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>300</effort><velocity>1.0</velocity></limit><dynamics><damping>5</damping><friction>0.5</friction></dynamics></axis></joint>
    <joint name="front_left_wheel_joint" type="revolute"><pose>0 0 0 0 0 0</pose><parent>front_left_knuckle</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>500</effort><velocity>50</velocity></limit><dynamics><damping>1.0</damping><friction>0.1</friction></dynamics></axis></joint>
    <joint name="front_right_wheel_joint" type="revolute"><pose>0 0 0 0 0 0</pose><parent>front_right_knuckle</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>500</effort><velocity>50</velocity></limit><dynamics><damping>1.0</damping><friction>0.1</friction></dynamics></axis></joint>
    <joint name="rear_left_wheel_joint" type="revolute"><pose>0 0 0 0 0 0</pose><parent>chassis</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>500</effort><velocity>50</velocity></limit><dynamics><damping>1.0</damping><friction>0.1</friction></dynamics></axis></joint>
    <joint name="rear_right_wheel_joint" type="revolute"><pose>0 0 0 0 0 0</pose><parent>chassis</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>500</effort><velocity>50</velocity></limit><dynamics><damping>1.0</damping><friction>0.1</friction></dynamics></axis></joint>

    <link name="steering_wheel"><pose>0.35 0 0.85 0 0 0</pose><inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link>
    <joint name="steering_wheel_joint" type="revolute"><parent>chassis</parent><child>steering_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-7.85</lower><upper>7.85</upper><effort>100</effort><velocity>20</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>

    <link name="camera_link"><pose>1.1 0 0.9 0 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><sensor name="camera" type="camera"><always_on>true</always_on><update_rate>5</update_rate><camera><horizontal_fov>1.396</horizontal_fov><image><width>320</width><height>180</height><format>R8G8B8</format></image></camera><plugin name="camera_controller" filename="libgazebo_ros_camera.so"><ros><namespace>/sim/camera</namespace></ros><camera_name>front</camera_name><frame_name>camera_link</frame_name></plugin></sensor></link>
    <joint name="camera_joint" type="fixed"><parent>chassis</parent><child>camera_link</child></joint>
    <link name="lidar_link"><pose>0 0 1.1 0 0 0</pose><inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><sensor name="lidar" type="ray"><always_on>true</always_on><update_rate>5</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.2</min><max>80</max></range></ray><plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so"><ros><namespace>/sim/lidar</namespace><remapping>~/out:=points</remapping></ros><output_type>sensor_msgs/PointCloud2</output_type></plugin></sensor></link>
    <joint name="lidar_joint" type="fixed"><parent>chassis</parent><child>lidar_link</child></joint>
    <link name="imu_link"><pose>0 0 0.7 0 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><sensor name="imu" type="imu"><always_on>true</always_on><update_rate>50</update_rate><plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so"><ros><namespace>/sim/imu</namespace><remapping>~/out:=data</remapping></ros><frame_name>imu_link</frame_name></plugin></sensor></link>
    <joint name="imu_joint" type="fixed"><parent>chassis</parent><child>imu_link</child></joint>
    <link name="gps_link"><pose>0 0 0.8 0 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><sensor name="gps" type="gps"><always_on>true</always_on><update_rate>10</update_rate><plugin name="gps_controller" filename="libgazebo_ros_gps_sensor.so"><ros><namespace>/sim/gnss</namespace><remapping>~/out:=data</remapping></ros></plugin></sensor></link>
    <joint name="gps_joint" type="fixed"><parent>chassis</parent><child>gps_link</child></joint>

    <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so"><ros><namespace>/sim/vehicle</namespace></ros><update_rate>50</update_rate><front_left_joint>front_left_wheel_joint</front_left_joint><front_right_joint>front_right_wheel_joint</front_right_joint><rear_left_joint>rear_left_wheel_joint</rear_left_joint><rear_right_joint>rear_right_wheel_joint</rear_right_joint><left_steering_joint>front_left_steering_joint</left_steering_joint><right_steering_joint>front_right_steering_joint</right_steering_joint><steering_wheel_joint>steering_wheel_joint</steering_wheel_joint><max_steer>0.6</max_steer><max_speed>2.0</max_speed><left_steering_pid_gain>80 0 5</left_steering_pid_gain><left_steering_i_range>-0.2 0.2</left_steering_i_range><right_steering_pid_gain>80 0 5</right_steering_pid_gain><right_steering_i_range>-0.2 0.2</right_steering_i_range><linear_velocity_pid_gain>20 0 1</linear_velocity_pid_gain><linear_velocity_i_range>-1 1</linear_velocity_i_range><publish_odom>false</publish_odom></plugin>
    <plugin name="vehicle_ground_truth_odom" filename="libgazebo_ros_p3d.so"><ros><namespace>/sim/vehicle</namespace><remapping>odom:=odom</remapping></ros><body_name>chassis</body_name><frame_name>chassis</frame_name><update_rate>50</update_rate></plugin>
  </model>
</sdf>
