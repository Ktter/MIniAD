<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ego_vehicle">
    <pose>0 0 0.34 0 0 0</pose>

    <link name="chassis">
      <inertial>
        <mass>1200</mass>
        <inertia><ixx>500</ixx><iyy>900</iyy><izz>1000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision"><geometry><box><size>2.4 1.4 0.5</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>2.4 1.4 0.5</size></box></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
    </link>

    <link name="front_left_knuckle">
      <pose>0.8 0.80 0 0 0 0</pose>
      <inertial><mass>8</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <link name="front_right_knuckle">
      <pose>0.8 -0.80 0 0 0 0</pose>
      <inertial><mass>8</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>

    <link name="front_left_wheel">
      <pose>0.8 0.80 0 0 0 0</pose>
      <inertial><mass>20</mass><inertia><ixx>0.579</ixx><iyy>1.024</iyy><izz>0.579</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.8 -0.80 0 0 0 0</pose>
      <inertial><mass>20</mass><inertia><ixx>0.579</ixx><iyy>1.024</iyy><izz>0.579</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.8 0.80 0 0 0 0</pose>
      <inertial><mass>20</mass><inertia><ixx>0.579</ixx><iyy>1.024</iyy><izz>0.579</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.8 -0.80 0 0 0 0</pose>
      <inertial><mass>20</mass><inertia><ixx>0.579</ixx><iyy>1.024</iyy><izz>0.579</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <joint name="front_left_steering_joint" type="fixed"><parent>chassis</parent><child>front_left_knuckle</child></joint>
    <joint name="front_right_steering_joint" type="fixed"><parent>chassis</parent><child>front_right_knuckle</child></joint>

    <joint name="front_left_wheel_joint" type="fixed"><parent>front_left_knuckle</parent><child>front_left_wheel</child></joint>
    <joint name="front_right_wheel_joint" type="fixed"><parent>front_right_knuckle</parent><child>front_right_wheel</child></joint>
    <joint name="rear_left_wheel_joint" type="fixed"><parent>chassis</parent><child>rear_left_wheel</child></joint>
    <joint name="rear_right_wheel_joint" type="fixed"><parent>chassis</parent><child>rear_right_wheel</child></joint>

    <link name="steering_wheel">
      <pose>0.35 0 0.85 0 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="steering_wheel_joint" type="fixed"><parent>chassis</parent><child>steering_wheel</child></joint>

    <link name="camera_front_link">
      <pose>1.1 0 0.9 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="camera_front" type="camera">
        <always_on>true</always_on><update_rate>5</update_rate>
        <camera><horizontal_fov>1.396</horizontal_fov><image><width>320</width><height>180</height><format>R8G8B8</format></image><clip><near>0.05</near><far>100</far></clip></camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so"><ros><namespace>/sim/camera</namespace></ros><camera_name>front</camera_name><frame_name>camera_front_link</frame_name></plugin>
      </sensor>
    </link>
    <joint name="camera_fixed_joint" type="fixed"><parent>chassis</parent><child>camera_front_link</child></joint>

    <link name="lidar_link">
      <pose>0 0 1.1 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="lidar" type="ray">
        <always_on>true</always_on><update_rate>5</update_rate>
        <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical></scan><range><min>0.2</min><max>80</max></range></ray>
        <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so"><ros><namespace>/sim/lidar</namespace><remapping>~/out:=points</remapping></ros><output_type>sensor_msgs/PointCloud2</output_type><frame_name>lidar_link</frame_name></plugin>
      </sensor>
    </link>
    <joint name="lidar_fixed_joint" type="fixed"><parent>chassis</parent><child>lidar_link</child></joint>

    <link name="imu_link">
      <pose>0 0 0.7 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="imu" type="imu">
        <always_on>true</always_on><update_rate>50</update_rate>
        <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so"><ros><namespace>/sim/imu</namespace><remapping>~/out:=data</remapping></ros><frame_name>imu_link</frame_name></plugin>
      </sensor>
    </link>
    <joint name="imu_fixed_joint" type="fixed"><parent>chassis</parent><child>imu_link</child></joint>

    <link name="gps_link">
      <pose>0 0 0.8 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="gps" type="gps">
        <always_on>true</always_on><update_rate>10</update_rate>
        <plugin name="gps_controller" filename="libgazebo_ros_gps_sensor.so"><ros><namespace>/sim/gnss</namespace><remapping>~/out:=data</remapping></ros><frame_name>gps_link</frame_name></plugin>
      </sensor>
    </link>
    <joint name="gps_fixed_joint" type="fixed"><parent>chassis</parent><child>gps_link</child></joint>

    <!-- Kinematic fallback for the laptop demo: keeps body motion stable while
         the wheel-level Ackermann dynamics are being tuned. -->
    <plugin name="planar_move_fallback" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/sim/vehicle</namespace></ros>
      <update_rate>100</update_rate>
      <publish_rate>10</publish_rate>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>


    <plugin name="vehicle_ground_truth_odom" filename="libgazebo_ros_p3d.so">
      <ros><namespace>/sim/vehicle</namespace><remapping>odom:=odom</remapping></ros>
      <body_name>chassis</body_name><frame_name>chassis</frame_name><update_rate>50</update_rate><gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </model>
</sdf>
